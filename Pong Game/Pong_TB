library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity pong_TB is
end pong_TB;

architecture pong_TB_ARCH of pong_TB is
   ----------------------------------------------------------TYPE DEFINITIONS--
type t_TEST is record
    P1En: std_logic;
    P2En: std_logic;
    rst:  std_logic;
    LEDS: std_logic_vector(15 downto 0);
    P1Ones: std_logic_vector(3 downto 0);
    P2Ones: std_logic_vector(3 downto 0);
end record t_TEST;

type t_TEST_ARRAY is array (positive range <>) of t_TEST;

    ----------------------------------------------------------CONSTANTS--
constant ACTIVE: std_logic := '1';

constant CLOCK_PERIOD: time := 10 ns;
constant STEP_TIME: time := 50 ns;


-- Tests: P1En, P2En, rst, LEDS, P1Ones, P2Ones

constant ALL_TESTS: t_TEST_ARRAY(1 to 26) := (

    -- P1   P2   rst       LEDS               P1Score P2Score

    ( '0', '0', '0', "1000000000000000", "0000", "0000" ), -- Start
    ( '0', '0', '0', "1000000000000000", "0000", "0000" ), -- Wait

    -- Player 1 serves
    ( '1', '0', '0', "0100000000000000", "0000", "0000" ), 
    ( '0', '0', '0', "0010000000000000", "0000", "0000" ), 
    ( '0', '0', '0', "0001000000000000", "0000", "0000" ),
    ( '0', '0', '0', "0000100000000000", "0000", "0000" ), 
    ( '0', '0', '0', "0000010000000000", "0000", "0000" ), 
    ( '0', '0', '0', "0000001000000000", "0000", "0000" ), 
    ( '0', '0', '0', "0000000100000000", "0000", "0000" ), 
    ( '0', '0', '0', "0000000010000000", "0000", "0000" ), 
    ( '0', '0', '0', "0000000001000000", "0000", "0000" ), 
    ( '0', '0', '0', "0000000000100000", "0000", "0000" ), 
    ( '0', '0', '0', "0000000000010000", "0000", "0000" ), 
    ( '0', '0', '0', "0000000000001000", "0000", "0000" ), 
    ( '0', '0', '0', "0000000000000100", "0000", "0000" ), 
    ( '0', '0', '0', "0000000000000010", "0000", "0000" ), 
    ( '0', '0', '0', "0000000000000001", "0000", "0000" ), -- Ball at P2
    
    -- Player 2 returns
    ( '0', '1', '0', "0000000000000010", "0000", "0000" ), 
    ( '0', '0', '0', "0000000000000100", "0000", "0000" ), 

    -- Player 1 presses too early, Player 2 scores
    ( '1', '0', '0', "0000000000000001", "0000", "0001" ), 

    -- Game restarts with Player 2 serving
    ( '0', '0', '0', "0000000000000001", "0000", "0001" ), -- Wait
    ( '0', '1', '0', "0000000000000010", "0000", "0001" ), -- P2 serves
    ( '0', '0', '0', "0000000000000100", "0000", "0001" ), 

    -- Reset the game
    ( '0', '0', '1', "1000000000000000", "0000", "0000" ), 
    ( '0', '0', '0', "1000000000000000", "0000", "0000" ), 

    -- Player 1 serves again
    ( '1', '0', '0', "0100000000000000", "0000", "0000" )  

);


    -----------------------------------------------------------------COMPONENT--
    -- uut: pong
    component pong is
        generic(
            COUNT_10KHZ: integer := 10000
        );
        port(
            clock:  in  std_logic;
            reset:  in  std_logic;
            P1En:   in  std_logic;   
            P2En:   in  std_logic;   
            LEDS:   out std_logic_vector(15 downto 0);
            P1Ones: out std_logic_vector(3 downto 0);
            P2Ones: out std_logic_vector(3 downto 0)
        );
    end component;

    -----------------------------------------------------------------FUNCTIONS--

    -- convert std_logic_vector to string for logging
    function print_bits (
        bits: std_logic_vector
    ) return string is
        variable bitsString: string(1 to bits'length);
        variable i: integer range 1 to bits'length;
    begin
        -- track position in string separately
        -- to show ranges in both directions correctly
        i := 1;

        for j in bits'range loop
            -- note, std_logic'image takes the form "'X'", so extract 2nd char
            bitsString(i) := std_logic'image(bits(j))(2);
            i := i + 1;
        end loop;

        -- return between quotes
        return '"' & bitsString & '"';
    end function;

    -------------------------------------------------------------------SIGNALS--
    signal clock:    std_logic := not ACTIVE;
    signal reset:    std_logic;
    signal resetRequest: std_logic := not ACTIVE;
    signal P1En:     std_logic := not ACTIVE;
    signal P2En:     std_logic := not ACTIVE;
    signal LEDS:     std_logic_vector(15 downto 0);
    signal P1Ones:   std_logic_vector(3 downto 0);
    signal P2Ones:   std_logic_vector(3 downto 0);
begin
    -- generate reset signal for synchronous elements
    -- out: initRst
    DRIVE_RESET: process is
    begin
        -- reset to known state before running any tests
        reset <= ACTIVE;
    wait for 17 ns;

        -- keep low for rest of test
         reset <= not ACTIVE;
         
          -- reset when requested by testbench
    loop
        wait until resetRequest = ACTIVE;
        reset <= ACTIVE;

        wait until resetRequest = not ACTIVE;
        reset <= not ACTIVE;
    end loop;
        wait;
    end process;



    -- generate clock for synchronous elements
    -- out: clock
    DRIVE_CLOCK: process is
    begin
        clock <= not ACTIVE;
        wait for (CLOCK_PERIOD / 2);

        clock <= ACTIVE;
        wait for (CLOCK_PERIOD / 2);

        -- note, processes unterminated by a wait will repeat indefinitely
    end process;

    -- generate test inputs for pong and check outputs
    -- in : LEDS, P1Ones, P2Ones
    -- out: P1En, P2En, testRst
    ----------------------------------------------------------DRIVE_INPUTS--

DRIVE_INPUTS: process is
begin
    P1En <= not ACTIVE;
    P2En <= not ACTIVE;
    resetRequest <= not ACTIVE;
    
    wait until(reset = not ACTIVE);
    wait until rising_edge(clock);
    wait for (STEP_TIME);

    for i in ALL_TESTS'range loop

        -- Set inputs
        P1En <= ALL_TESTS(i).P1En;
        P2En <= ALL_TESTS(i).P2En;
        resetRequest <= ALL_TESTS(i).rst;

        -- Hold inputs for 2 clock cycles
        wait for 20ns;

        P1En <= not ACTIVE;
        P2En <= not ACTIVE;
        resetRequest <= not ACTIVE;

        -- Wait for next ball movement
        wait for 30ns;

        -- Check LED position
        assert (LEDS = ALL_TESTS(i).LEDS)
            report "FAILED TEST #" & integer'image(i) & " LEDS";
            

        -- Check Player 1 score
        assert (P1Ones = ALL_TESTS(i).P1Ones)
            report "FAILED TEST #" & integer'image(i) & " P1 SCORE";
            

        -- Check Player 2 score
        assert (P2Ones = ALL_TESTS(i).P2Ones)
            report "FAILED TEST #" & integer'image(i) & " P2 SCORE";
            

    end loop;


    wait;
end process;


    -- map pong to test signals
    UUT: pong
        generic map( COUNT_10KHZ => 4 )
        port map(
            clock  => clock,
            reset  => reset,
            P1En   => P1En,
            P2En   => P2En,
            LEDS   => LEDS,
            P1Ones => P1Ones,
            P2Ones => P2Ones
        );
end pong_TB_ARCH;
