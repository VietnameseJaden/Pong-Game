library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity pong_TB is
end pong_TB;

architecture pong_TB_ARCH of pong_TB is
   ----------------------------------------------------------TYPE DEFINITIONS--
type t_TEST is record
    P1En:  std_logic;
    P2En:  std_logic;
    winCount:  std_logic_vector(15 downto 0);
    cycles: integer;
end record t_TEST;

type t_TEST_ARRAY is array (natural range <>) of t_TEST;

    ----------------------------------------------------------CONSTANTS--
constant ACTIVE: std_logic := '1';

constant CLOCK_PERIOD: time := 10 ns;
constant SAMPLE_PERIOD: time := 50ns;
constant STEP_TIME: time := 50 ns;


-- Tests: P1En, P2En, rst, LEDS, P1Ones, P2Ones

constant ALL_TESTS: t_TEST_ARRAY := (

   -- P1En P2En winCount cycles

    ('0', '0', X"0002", 5),    -- idle

    ('1', '0', X"0002", 5),    -- P1 serve

    ('0', '0', X"0002", 160),  -- ball travels to position 0

    ('0', '1', X"0002", 5),    -- P2 hit

    ('0', '0', X"0002", 160),  -- ball travels to position 15

    ('1', '0', X"0002", 5),     -- P1 hit

    ('0', '0', X"0002", 105),   -- ball travels back
    
    ('0', '1', X"0002", 5),     -- P2 misses
    
    ('0', '0', X"0002", 10),    -- buffer
    
    ('0', '1', X"0002", 5),     -- P2 serve
    
    ('0', '0', X"0002", 155),  -- ball travels to position 15
    
    ('1', '0', X"0002", 5),    -- P1 hit
    
    ('0', '0', X"0002", 130),  -- ball travels
    
    ('0', '1', X"0002", 5)     -- P2 misses (P1winEn = ACTIVE) 
);


    -----------------------------------------------------------------COMPONENT--
    -- uut: pong
    component pong is
    generic(
        CLOCK_PERIOD: time;
        SAMPLE_PERIOD: time;
        DEPTH: integer;
        BYPASS_DEBOUNCE: boolean;
        LED_SPEED: integer
    );
        port(
            clock:  in  std_logic;
            reset:  in  std_logic;
            P1En:   in  std_logic;   
            P2En:   in  std_logic;   
            winCount: in std_logic_vector(15 downto 0);
            P1win: out std_logic;
            P2win: out std_logic;
            LEDS:   out std_logic_vector(15 downto 0);
            P1Ones: out std_logic_vector(3 downto 0);
            P1Tens: out std_logic_vector(3 downto 0);
            P2Ones: out std_logic_vector(3 downto 0);
            P2Tens: out std_logic_vector(3 downto 0)
        );
    end component;

    

    -------------------------------------------------------------------SIGNALS--
    signal clock:    std_logic := not ACTIVE;
    signal reset:    std_logic := not ACTIVE;
    signal P1En:     std_logic := not ACTIVE;
    signal P2En:     std_logic := not ACTIVE;
    signal LEDS:     std_logic_vector(15 downto 0);
    signal winCount: std_logic_vector(15 downto 0);
    signal P1win: std_logic := not ACTIVE; 
    signal P2win: std_logic := not ACTIVE;
    signal P1Ones:   std_logic_vector(3 downto 0);
    signal P1Tens:   std_logic_vector(3 downto 0);
    signal P2Ones:   std_logic_vector(3 downto 0);
    signal P2Tens:   std_logic_vector(3 downto 0);
begin
    -- generate reset signal for synchronous elements
    -- out: initRst
    DRIVE_RESET: process is
    begin
        -- reset to known state before running any tests
        reset <= ACTIVE;
        wait for 17 ns;

        -- keep low for rest of test
        reset <= not ACTIVE;  
        wait;
    end process;




    -- generate clock for synchronous elements
    -- out: clock
    DRIVE_CLOCK: process is
    begin
        clock <= not ACTIVE;
        wait for (CLOCK_PERIOD / 2);

        clock <= ACTIVE;
        wait for (CLOCK_PERIOD / 2);

    end process;

    -- generate test inputs for pong and check outputs
    -- in : LEDS, P1Ones, P2Ones
    -- out: P1En, P2En, testRst
    ----------------------------------------------------------DRIVE_INPUTS--

DRIVE_INPUTS: process(clock, reset) is
    variable index: integer; 
    variable cyclesCount: integer;
begin
    if (reset = ACTIVE) then 
        index := 0; 
        cyclesCount := 0;
        P1En <= not ACTIVE;
        P2En <= not ACTIVE; 
        winCount <= X"0002"; 
    elsif (rising_edge(clock)) then 
        if (index < ALL_TESTS'Length) then 
                P1En <= ALL_TESTS(index).P1En;
                P2En <= ALL_TESTS(index).P2En;
                winCount <= ALL_TESTS(index).winCount;
                if(cyclesCount < ALL_TESTS(index).cycles - 1) then
                    cyclesCount := cyclesCount + 1;
                else 
                    cyclesCount := 0;
                    index := index + 1;
                end if;
        end if;
    end if;
 end process DRIVE_INPUTS;


    -- map pong to test signals
    UUT: pong
    generic map(
        CLOCK_PERIOD => CLOCK_PERIOD,
        SAMPLE_PERIOD => SAMPLE_PERIOD,
        DEPTH => 16,
        BYPASS_DEBOUNCE => true,
        LED_SPEED => 10
    )
        port map(
            clock  => clock,
            reset  => reset,
            P1En   => P1En,
            P2En   => P2En,
            winCount => winCount,
            P1win => P1win,
            P2win => P2win,
            LEDS   => LEDS,
            P1Ones => P1Ones,
            P1Tens => P1Tens,
            P2Ones => P2Ones,
            P2Tens => P2Tens
        );
end pong_TB_ARCH;