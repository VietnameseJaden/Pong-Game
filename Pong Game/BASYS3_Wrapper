entity BASYS3_Wrapper is
--  Port ( );
    port
    (
        btnL: in std_logic;
        btnR: in std_logic;
        btnC: in std_logic;
        led: out std_logic_vector(15 downto 0);
        seg: out std_logic_vector(6 downto 0);
        clk: in std_logic;
        an: out std_logic_vector(3 downto 0)
    );
    
end BASYS3_Wrapper;

architecture BASYS3_Wrapper_ARCH of BASYS3_Wrapper is
    constant ACTIVE: std_logic := '1';

    component Pong_Design is
    port
    (
        clock: in std_logic;
        reset: in std_logic;
        P1En: in std_logic;
        P2En: in std_logic;
        LEDS: out std_logic_vector(15 downto 0);
        P1Ones: out std_logic_vector(3 downto 0);
        P2Ones: out std_logic_vector(3 downto 0)
    );
    end component;

    component SevenSegmentDriver is
    port
    (
        reset: in std_logic;
        clock: in std_logic;
        digit3: in std_logic_vector(3 downto 0); --leftmost digit
        digit2: in std_logic_vector(3 downto 0); --2nd from left digit
        digit1: in std_logic_vector(3 downto 0); --3rd from left digit
        digit0: in std_logic_vector(3 downto 0); --rightmost digit
        blank3: in std_logic; --leftmost digit
        blank2: in std_logic; --2nd from left digit
        blank1: in std_logic; --3rd from left digit
        blank0: in std_logic; --rightmost digit
        sevenSegs: out std_logic_vector(6 downto 0); --MSB=g, LSB=a
        anodes: out std_logic_vector(3 downto 0) --MSB=leftmost digit
        );
    end component;

    component Debouncer is 
    port 
    (
        reset: in std_logic;
        clock: in std_logic;
        asyncIn1: in std_logic;
        asyncIn2: in std_logic;
        syncOut1: out std_logic;
        syncOut2: out std_logic    
    );
    end component;

    signal reset: std_logic;
    signal clock: std_logic;
    signal blankOnes: std_logic;
    signal P1Score: std_logic_vector(3 downto 0);
    signal P2Score: std_logic_vector(3 downto 0);
    signal btnRSync: std_logic;
    signal btnLSync: std_logic;

begin
    clock <= clk;
    reset <= btnC;
    SYNC_BUTTONS: Debouncer 
    port map(
        reset => reset,
        clock => clock,
        asyncIn1 => btnR,
        asyncIn2 => btnL,
        syncOut1 => btnRSync,
        syncOut2 => btnLSync
    );

    UUT: Pong_Design 
    port map(
        clock => clock,
        reset => reset,
        P1En => btnRSync,
        P2En => btnLSync,   
        LEDS => led,
        P1Ones => P1Score,
        P2Ones => P2Score
    );

    DRIVE_SEG: SevenSegmentDriver
     port map(
        reset => reset,
        clock => clock,
        digit3 => P1Score,
        digit2 => "0000",
        digit1 => "0000",
        digit0 => P2Score,
        blank3 => not ACTIVE,
        blank2 => ACTIVE,
        blank1 => ACTIVE,
        blank0 => not ACTIVE,
        sevenSegs => seg,
        anodes => an
    );

end BASYS3_Wrapper_ARCH;
 